<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build file for the MNIST Handwritten Digit Classifier (KTU S3 OOP micro project).

  Two things are built from this one project:
    1. ModelTrainer - a one time console program that trains the network and saves mnist_model.zip
    2. Main        - the Swing desktop application that only loads the saved model
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.college</groupId>
    <artifactId>mnist-digit-classifier</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <name>MNIST Digit Classifier</name>
    <description>Swing + DL4J + SQLite handwritten digit classifier</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- All Deeplearning4j / ND4J artifacts share this one version -->
        <dl4j.version>1.0.0-M2.1</dl4j.version>
        <!-- Default program started by "mvn exec:java"; override with -Dexec.mainClass=... -->
        <exec.mainClass>com.college.mnist.Main</exec.mainClass>
    </properties>

    <dependencies>
        <!-- Deeplearning4j: neural network layers, training, evaluation, model save/load -->
        <dependency>
            <groupId>org.deeplearning4j</groupId>
            <artifactId>deeplearning4j-core</artifactId>
            <version>${dl4j.version}</version>
            <exclusions>
                <!-- DL4J pulls in the older SLF4J 1.7 API; the 2.x API below is the
                     only one kept, so the logging binding matches. -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ND4J native platform: brings the CPU math backend and native binaries for all OSes -->
        <dependency>
            <groupId>org.nd4j</groupId>
            <artifactId>nd4j-native-platform</artifactId>
            <version>${dl4j.version}</version>
        </dependency>

        <!-- SQLite JDBC driver: talks to the digits.db file -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>

        <!-- Simple logging binding, otherwise SLF4J prints "no provider" warnings -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Resource and lifecycle plugins are pinned so the build does not
                 depend on which Maven version is installed. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.3.2</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <!--
              Lets the project run straight from Maven:
                mvn exec:java -Dexec.mainClass=com.college.mnist.model.ModelTrainer
                mvn exec:java -Dexec.mainClass=com.college.mnist.Main
              Working directory is the project folder, so digits.db and mnist_model.zip
              are created there.

              The two system properties keep DL4J's own caches inside target/, so a
              fresh checkout runs without write access to the user's home folder:
                - ND4J's native libraries (bytedeco/javacpp) are unpacked once
                - the MNIST download is stored once, in target/dl4j-data
              Both are normal system properties. To use the usual locations instead
              (~/.javacpp and ~/.deeplearning4j) start the program with:
                mvn exec:java -Dexec.mainClass=com.college.mnist.Main \
                    -Dexec.jvmArgs="-Dorg.deeplearning4j.resources.directory=$HOME/.deeplearning4j"
              Note: "mvn clean" deletes target/, so the next training run downloads
              MNIST again.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <!-- Default entry point; override per run with
                         -Dexec.mainClass=com.college.mnist.model.ModelTrainer -->
                    <mainClass>${exec.mainClass}</mainClass>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <systemProperties>
                        <systemProperty>
                            <key>org.bytedeco.javacpp.cachedir</key>
                            <value>${project.build.directory}/javacpp-cache</value>
                        </systemProperty>
                        <systemProperty>
                            <key>org.deeplearning4j.resources.directory</key>
                            <value>${project.build.directory}/dl4j-data</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>

            <!--
              Optional self-contained jar. It is NOT built during "package" because
              the ND4J native platform dependency contains the CPU backend for every
              operating system, which makes a single jar about 1.4 GB. Run it only
              when a jar is really needed:

                mvn -s maven-settings-localrepo.xml package assembly:single
                java -Dorg.bytedeco.javacpp.cachedir=target/javacpp-cache \
                     -jar target/mnist-digit-classifier-1.0-jar-with-dependencies.jar

              A slimmer jar is possible by replacing nd4j-native-platform with the
              nd4j-native artifact plus the classifier of one platform, for example
              nd4j-native:1.0.0-M2.1:windows-x86_64.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.college.mnist.Main</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
